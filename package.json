{
  "name": "explain-it-better",
  "version": "0.2.0",
  "private": true,
  "description": "A portable, confirmation-gated Agent Skill with optional local Power mode.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run skills:sync && npm run clean && tsc -b && node scripts/mark-cli-executable.mjs",
    "clean": "node scripts/clean-build.mjs",
    "dev": "npm run dev --workspace @eib/cli",
    "lint": "eslint .",
    "pack:check": "node scripts/validate-package-contents.mjs",
    "release:check": "npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run skills:check && npm run smoke:cli && npm run pack:check && npm audit --audit-level=high",
    "skills:sync": "node scripts/sync-skill-distributions.mjs",
    "skills:check": "node scripts/sync-skill-distributions.mjs --check",
    "smoke:cli": "node scripts/smoke-cli.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.8.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "test-exclude": "^8.0.0"
  }
}
